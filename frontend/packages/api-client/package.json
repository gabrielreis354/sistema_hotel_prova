{
  "name": "@hotel/api-client",
  "version": "0.0.0",
  "private": true,
  "description": "Cliente HTTP tipado, gerado do OpenAPI do backend (config/swagger.js).",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "dump": "node scripts/dump-openapi.mjs",
    "generate": "node scripts/dump-openapi.mjs && openapi-typescript ./openapi.json -o ./src/schema.d.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "openapi-fetch": "^0.13.4"
  },
  "devDependencies": {
    "@hotel/config": "workspace:*",
    "openapi-typescript": "^7.4.4",
    "typescript": "^5.6.3"
  }
}
