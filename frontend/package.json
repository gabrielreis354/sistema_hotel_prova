{
  "name": "hotel-frontend",
  "private": true,
  "version": "0.0.0",
  "description": "Monorepo de frontend do PMS Hotel SaaS (app-pms, booking, admin + design system).",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "gen:api": "pnpm --filter @hotel/api-client run generate"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.6.3"
  }
}
