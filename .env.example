# Variáveis do docker-compose.yml (contingência local — T-06.4).
# Copie para .env na raiz antes de rodar `docker compose up -d`.
# Os nomes batem com services/core-service/.env.example — o backend lê as mesmas variáveis,
# só que resolvendo os hosts pelo nome do serviço do compose (postgres, redis, minio, rabbitmq).

# Configurações do servidor
NODE_ENV=production
NODE_WEB_PORT=3000

# Porta do backend exposta no host (frontend local, fora do compose, aponta pra cá).
# Só precisa descomentar se a 3000 já estiver em uso na máquina — e aí ajustar também
# frontend/apps/pms/vite.config.ts para a mesma porta.
# BACKEND_HOST_PORT=3000

# PostgreSQL
POSTGRES_DB=gestao_hotel
POSTGRES_USER=hotel_user
POSTGRES_PASSWORD=hotel_password

# JWT em RS256 (ADR-006) — não há segredo de JWT neste arquivo. O backend usa um par de
# chaves que você gera UMA vez, antes do primeiro `docker compose up`:
#   node services/core-service/scripts/gerar_chaves_jwt.js
# O compose monta services/core-service/keys/ no container (somente leitura). Nunca
# versionar essa pasta — está no .gitignore e no .dockerignore.
# JWT_KEY_ID=core-v1

# Webhook PIX (OBRIGATÓRIO — o compose falha sem este valor). Sem ele, /webhooks/pix
# recusa toda requisição e a confirmação de pagamento da demo não funciona. Para simular
# um pagamento (roda DENTRO do container, onde o compose já injetou este segredo):
#   docker compose exec backend node scripts/simular_pagamento_pix.js <provider_charge_id>
PIX_WEBHOOK_SECRET=sua_chave_secreta_do_webhook_pix_aqui

# CORS — origens do frontend permitidas, separadas por vírgula. "*" libera qualquer origem.
CORS_ORIGINS=*

# MinIO S3 (armazenamento de PDFs de contratos)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BUCKET=hotel-contracts

# RabbitMQ — só provisionado nesta etapa (T-02.1/infra), nenhum código publica/consome ainda
RABBITMQ_DEFAULT_USER=hotel_broker
RABBITMQ_DEFAULT_PASS=rabbitmq_local_password
