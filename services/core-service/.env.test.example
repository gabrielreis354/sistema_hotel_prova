# Exemplo de ambiente de TESTES automatizados (vitest).
# Copie para .env.test e ajuste conforme seu Postgres local.
#   cp .env.test.example .env.test
#
# O globalSetup dos testes cria o banco 'gestao_hotel_test' e faz DROP+CREATE
# de todas as tabelas (sync force:true) — NUNCA aponte para o banco de produção.
NODE_ENV=test

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=gestao_hotel_test
POSTGRES_USER=hotel_user
POSTGRES_PASSWORD=hotel_password

PIX_WEBHOOK_SECRET=pms_hotel_test_pix_webhook_secret_2026

# JWT RS256 (ADR-006) — chaves EFÊMERAS, geradas pelo globalSetup dos testes
# antes da suíte rodar. Não precisa copiar arquivo nenhum, só manter os
# caminhos abaixo.
JWT_PRIVATE_KEY_PATH=tests/setup/.tmp-jwt-keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=tests/setup/.tmp-jwt-keys/jwt-public.pem
JWT_KEY_ID=core-test

# Pipeline dos indicadores (tests/analytics.test.js, T-01.4/H.3 — CA-01.4.p): o teste sobe o
# analytics-service (precisa de `npm ci` em services/analytics-service), publica o outbox no
# RabbitMQ e lê os indicadores do analytics. Sem RABBITMQ_HOST esse bloco é PULADO (o CI do core
# ainda não tem broker). Precisa da topologia e dos usuários de infra/k8s/rabbitmq-setup.sh.
# O analytics usa um database próprio neste mesmo PostgreSQL: gesway_analytics_pipeline_test.
RABBITMQ_HOST=
RABBITMQ_PORT=5672
RABBITMQ_CORE_USER=hotel_core_publisher
RABBITMQ_CORE_PASSWORD=
RABBITMQ_ANALYTICS_USER=hotel_analytics_consumer
RABBITMQ_ANALYTICS_PASSWORD=
ANALYTICS_PIPELINE_PORT=3063
