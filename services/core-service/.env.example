# Configurações do Servidor
NODE_ENV=development
NODE_WEB_PORT=3000

# Conexão com o PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=gestao_hotel
POSTGRES_USER=hotel_user
POSTGRES_PASSWORD=hotel_password

# JWT em RS256 (ADR-006/T-01.3, OBRIGATÓRIO). Gere o par local com:
#   node scripts/gerar_chaves_jwt.js
# Cria services/core-service/keys/{jwt-private,jwt-public}.pem — nunca versionar
# (é a única exceção à política de segredo versionado deste projeto). Caminhos
# abaixo já são o default do script; só mude se mover os arquivos.
JWT_PRIVATE_KEY_PATH=keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=keys/jwt-public.pem
JWT_KEY_ID=core-v1

# Segredo do webhook PIX (OBRIGATÓRIO — fail-closed: sem isto, /webhooks/pix
# recusa TODA requisição). O PSP assina o corpo com HMAC-SHA256 usando este
# segredo; o backend verifica no cabeçalho x-pix-signature. Combine com o PSP
# real na integração (T-01.6); no provider simulado, gere qualquer string forte.
PIX_WEBHOOK_SECRET=sua_chave_secreta_do_webhook_pix_aqui

# CORS — origens do frontend permitidas, separadas por vírgula.
# Ausente ou "*" libera qualquer origem (dev/CI). Em produção, liste os domínios reais.
# Ex.: CORS_ORIGINS=https://pms.meuhotel.com.br,https://admin.meuhotel.com.br
CORS_ORIGINS=*

# Cache (Redis)
# Local sem Docker: redis://localhost:6379
# Com Docker Compose: redis://redis:6379 (resolvido via DNS interno)
REDIS_URL=redis://localhost:6379

# MinIO S3 (armazenamento de PDFs de contratos)
# K8s: MINIO_ENDPOINT=http://minio:9000
# Local: MINIO_ENDPOINT=http://localhost:9000
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BUCKET=hotel-contracts
MINIO_USE_SSL=false
