# Dependências locais (nunca enviar ao daemon)
node_modules/
npm-debug.log*
*.log

# Variáveis de ambiente sensíveis
.env
.env.*
!.env.example

# SQL de criação (não pertence ao runtime — migrate usa Sequelize, não schema.sql)
db/

# seed/ fica: "node command.js seed" precisa do .sql em runtime (contingência T-06.4)

# Testes (não executam em produção)
tests/
vitest.config.js
coverage/

# Git e IDE
.git/
.gitignore
.gitattributes
.vscode/
.idea/

# Documentação
*.md
