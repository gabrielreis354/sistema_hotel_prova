# Ambiente dos testes do analytics (vitest). Copie para .env.test:
#   cp .env.test.example .env.test
#
# O globalSetup cria o banco 'gesway_analytics_test' e faz DROP+CREATE das projeções
# (sync force:true) — NUNCA aponte para um banco real.
NODE_ENV=test

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=gesway_analytics_test
POSTGRES_USER=hotel_user
POSTGRES_PASSWORD=hotel_password

# Par RS256 EFÊMERO, gerado pelo globalSetup. A privada existe só para os testes assinarem token
# como o core faria; o código do serviço lê apenas a pública.
JWT_PUBLIC_KEY_PATH=tests/setup/.tmp-jwt-keys/jwt-public.pem
TEST_JWT_PRIVATE_KEY_PATH=tests/setup/.tmp-jwt-keys/jwt-private.pem

# Teste de integração com RabbitMQ real (tests/rabbitmq.integration.test.js). Sem RABBITMQ_HOST ele
# é PULADO. Precisa da topologia e dos usuários do infra/k8s/rabbitmq-setup.sh: o teste publica
# com a credencial do core (como o publicador do outbox) e consome com a do analytics.
RABBITMQ_HOST=
RABBITMQ_PORT=5672
RABBITMQ_ANALYTICS_USER=hotel_analytics_consumer
RABBITMQ_ANALYTICS_PASSWORD=
RABBITMQ_CORE_USER=hotel_core_publisher
RABBITMQ_CORE_PASSWORD=
