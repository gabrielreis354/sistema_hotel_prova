# analytics-service (T-01.4) — copie para .env e ajuste.
NODE_ENV=development
NODE_WEB_PORT=3001

# Banco PRÓPRIO do analytics (CA-01.4.g) — nunca o banco do core.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=gesway_analytics
POSTGRES_USER=analytics_user
POSTGRES_PASSWORD=
# Limite de cada operação (ms): espera por conexão do pool e duração de cada comando SQL. Com eles todo
# evento termina em segundos — a pausa do consumidor espera o pior caso (catálogo §5.3).
POSTGRES_ACQUIRE_TIMEOUT_MS=5000
POSTGRES_STATEMENT_TIMEOUT_MS=5000

# JWT RS256 (ADR-006): só a chave PÚBLICA do core. O analytics verifica, nunca emite —
# montar a privada aqui é recusado no boot.
JWT_PUBLIC_KEY_PATH=keys/jwt-public.pem

# Consumidor (catálogo de eventos §8): credencial do analytics, que só lê a própria fila e publica
# na fila de mensagens mortas. Sem RABBITMQ_HOST o consumidor fica desligado.
RABBITMQ_HOST=
RABBITMQ_PORT=5672
RABBITMQ_ANALYTICS_USER=hotel_analytics_consumer
RABBITMQ_ANALYTICS_PASSWORD=
